{
  "name": "heyfans-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3070",
    "build": "next build",
    "start": "next start -p 3070",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "node scripts/dev/mongo-local.mjs",
    "db:init": "tsx --conditions=react-server --env-file=.env scripts/db/init.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env scripts/db/seed.ts",
    "admin:create": "tsx --conditions=react-server --env-file=.env scripts/db/create-admin.ts",
    "jobs:run": "tsx --conditions=react-server --env-file=.env scripts/jobs/run-once.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.4",
    "better-auth": "1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.59.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.2",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
