# ─── Uygulama ───────────────────────────────────────────────
# development | demo | production  (production'da mock sağlayıcılar reddedilir)
APP_MODE=development
APP_URL=http://localhost:3070

# ─── MongoDB ────────────────────────────────────────────────
# Yerel: npm run db:start → mongodb://127.0.0.1:27047/?replicaSet=rs0
# Üretim: MongoDB Atlas bağlantı dizesi (replika seti; transaction gerekir)
MONGODB_URI=mongodb://127.0.0.1:27047/?replicaSet=rs0
MONGODB_DB_NAME=heyfans

# ─── Kimlik doğrulama (Better Auth) ─────────────────────────
# En az 32 karakter rastgele değer: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Admin oturumlarında TOTP 2FA zorunlu (yalnız yerel geliştirmede false yapılabilir)
ADMIN_MFA_ENFORCED=true

# ─── AI ─────────────────────────────────────────────────────
# none | mock (yalnız geliştirme/test) | openai-compatible
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_MONTHLY_BUDGET_USD=0
# Maliyet takibi için model fiyatı (USD / 1M token)
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
AI_EMBEDDING_DIMENSIONS=1536
# local (uygulama içi kosinüs) | atlas ($vectorSearch, Atlas indeksi gerekir)
VECTOR_SEARCH_MODE=local

# ─── Ödeme ──────────────────────────────────────────────────
# none | mock (yalnız geliştirme/test, "TEST ÖDEMESİ") | iyzico | stripe
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─── Medya depolama ─────────────────────────────────────────
# local (yalnız geliştirme) | s3 (Cloudflare R2, AWS S3, MinIO)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── E-posta ────────────────────────────────────────────────
# outbox (geliştirme: /dev/outbox) | resend
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM="HEYFANS <no-reply@heyfans.ai>"

# ─── Gerçek zamanlı ses/görüntü ─────────────────────────────
RTC_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Yaş doğrulama ──────────────────────────────────────────
AGE_VERIFICATION_PROVIDER=none
AGE_VERIFICATION_PROVIDER_KEY=

# ─── Diğer ──────────────────────────────────────────────────
REDIS_URL=
# Vercel Cron → /api/cron/jobs  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# IBAN gibi hassas alanların AES-256-GCM şifrelemesi (32 bayt, base64)
DATA_ENCRYPTION_KEY=
# Özel medya için kısa ömürlü imzalı URL anahtarı
MEDIA_SIGNING_SECRET=

# Yalnız geliştirme/demo: seed ile oluşturulan demo hesapların parolası (en az 10 karakter)
SEED_DEMO_PASSWORD=
